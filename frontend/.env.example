# Copy to .env.local for local overrides. Never put secrets in this file.

# Backend origin for API calls.
# Leave EMPTY in development (the Vite proxy forwards calls) and in production
# (FastAPI serves the built frontend on the same origin).
VITE_API_BASE_URL=

# Development only: where the Vite proxy forwards API calls.
VITE_DEV_PROXY_TARGET=http://localhost:8000